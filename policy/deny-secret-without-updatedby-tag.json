{
  "properties": {
    "displayName": "Key Vault secrets must have an updatedBy tag",
    "description": "Denies creating or updating a Key Vault secret version unless it carries the updatedBy tag (set by Key Vault Manager on every save).",
    "policyType": "Custom",
    "mode": "Microsoft.KeyVault.Data",
    "metadata": {
      "category": "Key Vault",
      "version": "1.0.0"
    },
    "parameters": {
      "tagName": {
        "type": "String",
        "metadata": {
          "displayName": "Tag name",
          "description": "Tag every secret version must carry."
        },
        "defaultValue": "updatedBy"
      },
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Use Audit first to see what would be blocked, then switch to Deny."
        },
        "allowedValues": ["Deny", "Audit", "Disabled"],
        "defaultValue": "Deny"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.KeyVault.Data/vaults/secrets"
          },
          {
            "field": "[concat('tags[', parameters('tagName'), ']')]",
            "exists": "false"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
